  },
  "contract": {
    "auth": {
      "loginRequest": {
        "email": "string",
        "password": "string"
      },
      "loginResponse": {
        "access_token": "string",
        "token_type": "bearer"
      },
      "registerRequest": {
        "email": "email",
        "name": "string",
        "password": "string"
      },
      "scheme": "bearer-jwt"
    },
    "errors": {
      "alreadyExists": {
        "body": {
          "detail": "Already exists"
        },
        "status": 409
      },
      "danglingRef": {
        "body": {
          "detail": "Not found"
        },
        "status": 404
      },
      "invalidCredentials": {
        "body": {
          "detail": "Invalid credentials"
        },
        "status": 401
