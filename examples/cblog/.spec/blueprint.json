      {
        "auth": false,
        "entity": "User",
        "id": "POST /auth/login",
        "method": "POST",
        "operation": "login",
        "path": "/auth/login",
        "request": {
          "shape": {
            "email": "string",
            "password": "string"
          }
        },
        "response": {
          "kind": "token"
        },
        "status": 200
