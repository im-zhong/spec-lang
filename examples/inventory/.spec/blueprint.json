{
  "app": {
    "name": "InventoryAPI",
    "port": 8000,
    "prefix": "/api/v1",
    "title": "Inventory API",
    "version": "0.1.0"
  },
  "contract": {
    "auth": {
      "loginRequest": {
        "email": "string",
        "password": "string"
      },
      "loginResponse": {
        "access_token": "string",
        "token_type": "bearer"
      },
      "registerRequest": {
        "password": "string"
      },
      "scheme": "bearer-jwt"
    },
    "errors": {
      "alreadyExists": {
        "body": {
          "detail": "Already exists"
        },
        "status": 409
      },
      "danglingRef": {
        "body": {
          "detail": "Not found"
        },
        "status": 404
      },
      "guardFailed": {
        "body": {
          "detail": "Invalid state"
        },
        "status": 409
      },
      "invalidCredentials": {
        "body": {
          "detail": "Invalid credentials"
        },
        "status": 401
      },
      "notFound": {
        "body": {
          "detail": "Not found"
        },
        "status": 404
      },
      "unauthenticated": {
        "body": {
          "detail": "Not authenticated"
        },
        "status": 401
      },
      "validation": {
        "body": "fastapi-default",
        "status": 422
      }
    },
    "serialization": {
      "createDefaults": "omittable-appliesDefault",
      "entityKeys": "declaredFieldNames",
      "hiddenColumns": [
        "password_hash",
        "created_at"
      ],
      "idGeneration": "serverUuid4",
      "listOrder": "createdAtAscending",
      "listScope": "allRows",
      "listShape": "bareArray",
      "refFields": "referencedIdString"
    }
  },
  "database": {
    "engine": "postgres",
    "fallback": "sqlite:///./dev.db",
    "urlEnv": "DATABASE_URL",
    "urlFormat": "sqlalchemy-url"
  },
  "entities": [
    {
      "fields": [
        {
          "column": "id",
          "name": "id",
          "type": "uuid"
        },
        {
          "column": "name",
          "name": "name",
          "type": "string",
          "unique": true
        },
        {
          "column": "slug",
          "name": "slug",
          "type": "string",
          "unique": true
        }
      ],
      "name": "Category",
      "table": "categorys"
    },
    {
      "fields": [
        {
          "column": "description",
          "name": "description",
          "optional": true,
          "type": "string"
        },
        {
          "column": "discontinued",
          "default": false,
          "name": "discontinued",
          "type": "boolean"
        },
        {
          "column": "id",
          "name": "id",
          "type": "uuid"
        },
        {
          "column": "in_stock",
          "default": true,
          "name": "inStock",
          "type": "boolean"
        },
        {
          "column": "name",
          "name": "name",
          "type": "string"
        },
        {
          "column": "price",
          "name": "price",
          "type": "int"
        },
        {
          "column": "sku",
          "name": "sku",
          "type": "string",
          "unique": true
        }
      ],
      "name": "Product",
      "table": "products"
    }
  ],
  "lifecycles": [],
  "routes": [
    {
      "auth": false,
      "entity": "Category",
      "id": "GET /api/v1/categories",
      "method": "GET",
      "operation": "list",
      "path": "/api/v1/categories",
      "response": {
        "entity": "Category",
        "kind": "entityArray"
      },
      "status": 200
    },
    {
      "auth": false,
      "entity": "Category",
      "id": "GET /api/v1/categories/{id}",
      "method": "GET",
      "operation": "get",
      "path": "/api/v1/categories/{id}",
      "response": {
        "entity": "Category",
        "kind": "entity"
      },
      "status": 200
    },
    {
      "auth": false,
      "entity": "Category",
      "id": "POST /api/v1/categories",
      "method": "POST",
      "operation": "create",
      "path": "/api/v1/categories",
      "request": {
        "shape": {
          "name": "string",
          "slug": "string"
        }
      },
      "response": {
        "entity": "Category",
        "kind": "entity"
      },
      "status": 201
    },
    {
      "auth": false,
      "entity": "Category",
      "id": "PATCH /api/v1/categories/{id}",
      "method": "PATCH",
      "operation": "update",
      "path": "/api/v1/categories/{id}",
      "request": {
        "partial": true,
        "shape": {
          "name": "string",
          "slug": "string"
        }
      },
      "response": {
        "entity": "Category",
        "kind": "entity"
      },
      "status": 200
    },
    {
      "auth": false,
      "entity": "Category",
      "id": "DELETE /api/v1/categories/{id}",
      "method": "DELETE",
      "operation": "delete",
      "path": "/api/v1/categories/{id}",
      "response": {
        "kind": "empty"
      },
      "status": 204
    },
    {
      "auth": false,
      "entity": "Product",
      "id": "GET /api/v1/products",
      "method": "GET",
      "operation": "list",
      "path": "/api/v1/products",
      "response": {
        "entity": "Product",
        "kind": "entityArray"
      },
      "status": 200
    },
    {
      "auth": false,
      "entity": "Product",
      "id": "GET /api/v1/products/{id}",
      "method": "GET",
      "operation": "get",
      "path": "/api/v1/products/{id}",
      "response": {
        "entity": "Product",
        "kind": "entity"
      },
      "status": 200
    },
    {
      "auth": false,
      "entity": "Product",
      "id": "POST /api/v1/products",
      "method": "POST",
      "operation": "create",
      "path": "/api/v1/products",
      "request": {
        "shape": {
          "description": "string?",
          "discontinued": "boolean",
          "inStock": "boolean",
          "name": "string",
          "price": "int",
          "sku": "string"
        }
      },
      "response": {
        "entity": "Product",
        "kind": "entity"
      },
      "status": 201
    },
    {
      "auth": false,
      "entity": "Product",
      "id": "PATCH /api/v1/products/{id}",
      "method": "PATCH",
      "operation": "update",
      "path": "/api/v1/products/{id}",
      "request": {
        "partial": true,
        "shape": {
          "description": "string?",
          "discontinued": "boolean",
          "inStock": "boolean",
          "name": "string",
          "price": "int",
          "sku": "string"
        }
      },
      "response": {
        "entity": "Product",
        "kind": "entity"
      },
      "status": 200
    },
    {
      "auth": false,
      "entity": "Product",
      "id": "DELETE /api/v1/products/{id}",
      "method": "DELETE",
      "operation": "delete",
      "path": "/api/v1/products/{id}",
      "response": {
        "kind": "empty"
      },
      "status": 204
    },
    {
      "auth": false,
      "entity": "Product",
      "id": "GET /api/v1/products/count",
      "method": "GET",
      "operation": "count",
      "path": "/api/v1/products/count",
      "response": {
        "kind": "count"
      },
      "status": 200
    }
  ],
  "stack": {
    "dependencies": {
      "bcrypt": "5.0.0",
      "email-validator": "2.2.0",
      "fastapi": "0.141.1",
      "pydantic": "2.13.5",
      "pydantic-settings": "2.15.0",
      "pyjwt": "2.13.0",
      "sqlalchemy": "2.0.52",
      "uvicorn": "0.52.4"
    },
    "dev": {
      "httpx": "0.28.1",
      "pytest": "9.1.1"
    },
    "python": "3.13"
  }
}
